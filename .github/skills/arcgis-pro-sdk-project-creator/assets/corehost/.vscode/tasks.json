{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug-{{SafeProjectName}}",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/{{WorkspaceRelativeProjectPath}}/{{SafeProjectName}}.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-release-{{SafeProjectName}}",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/{{WorkspaceRelativeProjectPath}}/{{SafeProjectName}}.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}

