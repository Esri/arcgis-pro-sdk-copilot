<?xml version="1.0" encoding="utf-8" ?>
<ESRI.Configuration xmlns="http://schemas.esri.com/DADF/Registry" 
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///{{DamlInstallDir}}bin/ArcGIS.Desktop.Framework.xsd">
  <Name>{{SafeProjectName}}</Name>
  <AddInID>{{NewID}}</AddInID>
  <Description>{{SafeProjectName}} description</Description>
  <Version>1.0</Version>
  <Author>Author Name</Author>
  <Company>Acme</Company>
  <Date>{{Date}}</Date>
    <Targets>
      <Target name="ArcGISPro" version="{{VersionMajorMinor}}" />
    </Targets>
    <!-- CLR should be set to the target framework set in the .csproj -->
  <AddIn language="CLR:PluginDS" library="{{SafeProjectName}}.dll" namespace="{{SafeProjectName}}">
    <ArcGISPro>
      <PluginDatasources>
        <PluginDatasource id="{{SafeProjectName}}_Datasource" class="ProPluginDatasourceTemplate"/>
      </PluginDatasources>
    </ArcGISPro>
  </AddIn>
</ESRI.Configuration>