<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
	<ItemGroup>
    <Reference Include="ArcGIS.Core.dll">
      <HintPath>{{ProInstallDir}}\bin\ArcGIS.Core.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.CoreHost">
      <HintPath>{{ProInstallDir}}\bin\ArcGIS.CoreHost.dll</HintPath>
      <CopyLocal>False</CopyLocal>
      <Private>False</Private>
    </Reference>
	</ItemGroup>
  <ItemGroup>
    <Content Include="Config.xml"/>   
  </ItemGroup>
  <ItemGroup>
    <None Include="ProPluginCursorTemplate.cs" />
    <None Include="ProPluginDatasourceTemplate.cs" />
    <None Include="ProPluginTableTemplate.cs" />
  </ItemGroup>
  <PropertyGroup>
    <PackageType>Plugin</PackageType>
  </PropertyGroup>
  <Import Project="{{ProInstallDir}}\bin\Esri.ProApp.SDK.Desktop.targets" Condition="Exists('{{ProInstallDir}}\bin\Esri.ProApp.SDK.Desktop.targets') AND !Exists('Esri.ArcGISPro.Extensions.targets')" />
 </Project>
